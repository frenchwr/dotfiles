[user]
	email = will.french@canonical.com
	name = Will French
	signingkey = /home/will/.ssh/id_ed25519.pub
[color]
	ui = auto
[core]
	pager = less -F -X
	whitespace = cr-at-eol
	editor = vim
[commit]
	verbose = true
	gpgsign = true
[pager]
	branch = false
[alias]
	log-short = log --oneline
	log-pretty = log --pretty=format:\"%h %s %an\" --graph
	tree = ! git ls-tree --full-name --name-only -t -r HEAD | sed -e \"s/[^-][^\\/]*\\//   |/g\" -e \"s/|\\([^ ]\\)/|-- \\1/\"
	# example: git gpg-sign commit -m "create a signed commit with gpg instead of ssh"
	gpg-sign = "!f() { git -c gpg.format=openpgp -c user.signingkey=6D42B1A9B9E65074 \"$@\"; }; f"
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[gpg]
	format = ssh
[gitubuntu]
	lpuser = wfrench
